# =============================================================================
# MRI Medical Platform — environment variables
# Copy to `.env.local` for local dev. Never commit secrets.
# =============================================================================

# --- Required (core) ---
DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:5432/db"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="random-cron-bearer-token"

# --- Pi Network (production payments) ---
PI_API_KEY=""
# PI_NETWORK_API_KEY=""  # alias for PI_API_KEY
PI_SANDBOX="true"
NEXT_PUBLIC_PI_SANDBOX="true"

# --- Rate limiting (optional — falls back to in-memory without Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- File storage ---
STORAGE_PROVIDER="local"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""
# R2_ENDPOINT=""

# --- Background workers (OCR / face / fraud) ---
WORKER_SECRET=""

# --- Online video (Jitsi) ---
ONLINE_APPOINTMENTS_ENABLED="true"
NEXT_PUBLIC_ONLINE_APPOINTMENTS_ENABLED="true"
JITSI_SERVER_URL="https://meet.jit.si"
JITSI_ROOM_SECRET=""

# --- Auth cookies (Pi Browser / cross-site) ---
NEXTAUTH_CROSS_SITE="false"
# Keep false for Pi Browser — partitioned cookies break dashboard navigation in iframe.
NEXTAUTH_COOKIE_PARTITIONED="false"
AUTH_AUTO_VERIFY_EMAIL="false"

# --- Referrals ---
REFERRAL_REWARD_PI="1"
NEXT_PUBLIC_REFERRAL_REWARD_PI="1"

# --- Monitoring (optional) ---
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""
# SENTRY_ENVIRONMENT="development"
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# --- External services (optional) ---
# DEEPFACE_SERVICE_URL=""
# SCFHS_LICENSE_API_URL=""
# SCFHS_LICENSE_API_KEY=""

# --- Deploy ---
# SKIP_MIGRATE_DEPLOY="false"
# VERCEL=1
