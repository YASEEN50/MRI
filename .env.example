# Copy to .env and fill in values: cp .env.example .env

# ── Database (Neon recommended) ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# ── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000
# Pi Browser iframe cookies (production HTTPS sets cross-site automatically)
NEXTAUTH_CROSS_SITE=false
NEXTAUTH_COOKIE_PARTITIONED=false

# ── Pi Network ──────────────────────────────────────────────────────────────
PI_API_KEY=
PI_SANDBOX=true
NEXT_PUBLIC_PI_SANDBOX=true

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ── Storage (use r2 in production) ──────────────────────────────────────────
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

# ── Workers & security ──────────────────────────────────────────────────────
WORKER_SECRET=generate-a-random-secret
CRON_SECRET=generate-a-random-secret
AUDIT_LOG_SECRET=generate-a-random-secret

# ── Google Cloud Vision (doctor license OCR) ────────────────────────────────
GOOGLE_CLOUD_VISION_API_KEY=

# ── Rate limiting (recommended in production) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# JITSI_ROOM_SECRET=
# REFERRAL_REWARD_PI=1
# AUTH_AUTO_VERIFY_EMAIL=false
# PI_ONLY_AUTH=true
